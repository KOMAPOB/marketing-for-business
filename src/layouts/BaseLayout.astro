---
import Analytics from "../components/Analytics.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, path = "/", noindex = false } = Astro.props;
const canonical = new URL(path, Astro.site ?? "https://marketing-for-business.ru").toString();
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="/visual-marketing-system.svg" />
    <meta name="theme-color" content="#101a18" />
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>
