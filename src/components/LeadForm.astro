---
const compact = Astro.props.compact ?? false;
---

<form class:list={["lead-form", { compact }]} name="lead" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/success">
  <input type="hidden" name="form-name" value="lead" />
  <p class="hidden">
    <label>Не заполняйте это поле: <input name="bot-field" /></label>
  </p>

  <label for="phone">Телефон для связи</label>
  <div class="form-row">
    <input
      id="phone"
      name="phone"
      type="tel"
      inputmode="tel"
      autocomplete="tel"
      value="+7 "
      placeholder="+7 (999) 000-00-00"
      maxlength="18"
      pattern="\+7 \([0-9]{3}\) [0-9]{3}-[0-9]{2}-[0-9]{2}"
      title="Введите телефон в формате +7 (999) 000-00-00"
      required
    />
    <button type="submit">Получить разбор</button>
  </div>

  <label class="consent">
    <input type="checkbox" name="privacy" required />
    <span>Согласен на обработку персональных данных и принимаю <a href="/privacy">политику конфиденциальности</a>.</span>
  </label>
</form>

<script>
  const phoneInput = document.querySelector<HTMLInputElement>("#phone");

  function formatRuPhone(value: string) {
    const digits = value.replace(/\D/g, "").replace(/^8/, "7");
    const body = digits.startsWith("7") ? digits.slice(1, 11) : digits.slice(0, 10);
    const parts = [
      body.slice(0, 3),
      body.slice(3, 6),
      body.slice(6, 8),
      body.slice(8, 10)
    ];

    let formatted = "+7";
    if (parts[0]) formatted += ` (${parts[0]}`;
    if (parts[0]?.length === 3) formatted += ")";
    if (parts[1]) formatted += ` ${parts[1]}`;
    if (parts[2]) formatted += `-${parts[2]}`;
    if (parts[3]) formatted += `-${parts[3]}`;
    return formatted === "+7" ? "+7 " : formatted;
  }

  phoneInput?.addEventListener("input", () => {
    phoneInput.value = formatRuPhone(phoneInput.value);
  });

  phoneInput?.addEventListener("focus", () => {
    if (!phoneInput.value.trim()) phoneInput.value = "+7 ";
  });

  phoneInput?.addEventListener("keydown", (event) => {
    const protectedStart = 3;
    if ((event.key === "Backspace" || event.key === "Delete") && phoneInput.selectionStart !== null && phoneInput.selectionStart <= protectedStart) {
      event.preventDefault();
    }
  });
</script>
